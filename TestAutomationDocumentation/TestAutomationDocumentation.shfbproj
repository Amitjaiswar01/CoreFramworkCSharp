    <RootNamespace>TestAutomationDocumentation</RootNamespace>
    <Name>TestAutomationDocumentation</Name>
    <!-- SHFB properties -->
    <FrameworkVersion>.NET Framework 4.7</FrameworkVersion>
    <OutputPath>.\Help\</OutputPath>
