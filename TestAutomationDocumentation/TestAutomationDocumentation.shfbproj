    <NamingMethod>MemberName</NamingMethod>
    <ContentPlacement>BelowNamespaces</ContentPlacement>
    <VisibleItems>Attributes, ExplicitInterfaceImplementations, InheritedMembers, InheritedFrameworkMembers, InheritedFrameworkInternalMembers, Internals, Protected, SealedProtected, ProtectedInternalAsProtected, NoPIATypes, PublicCompilerGenerated, EditorBrowsableNever, NonBrowsable</VisibleItems>
    <NamespaceSummaries>
      <NamespaceSummaryItem name="(global)" isDocumented="False" />
<NamespaceSummaryItem name="LampsPlus.Automation" isDocumented="True">Base namespace for Test Automation work. This namespace contains generic logic for UI testing with Selenium.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Framework (Group)" isGroup="True" isDocumented="True">Provides generic functionality for UI testing using Selenium.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Framework" isDocumented="True">Provides generic functionality for UI testing using Selenium.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Framework.Enums" isDocumented="True">Provides general enums needed for the test automation framework.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Framework.Utilities" isDocumented="True">Provides generic framework utilities to support UI testing with Selenium.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.RestApi.Framework" isDocumented="True">Provides a generic ability to make REST requests.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests (Group)" isGroup="True" isDocumented="True">Container of Lamps Plus UI regression tests.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests" isDocumented="True">Container of Lamps Plus UI regression tests.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests._Docs" isDocumented="False" />
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Constants" isDocumented="True">Container of static information needed for testing. This namespace contains all standard definitions for Lamps Plus tests.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Databases.Actions" isDocumented="True">Contains helper methods for database actions. This is the main entry point to provide tests access to query data from the database.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Databases.Entities" isDocumented="True">Contains models for database data. This contains the definitions for database objets.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Databases.Queries" isDocumented="True">Contains raw SQL queries to use for tests.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Enums" isDocumented="True">Contains Lamps Plus specific enums used for testing.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Pages" isDocumented="True">Container of page objets for Lamps Plus test automation.</NamespaceSummaryItem>
<NamespaceSummaryItem name="LampsPlus.Automation.Tests.Pages.CreateAccount" isDocumented="True">Lamps Plus page object.</NamespaceSummaryItem>
